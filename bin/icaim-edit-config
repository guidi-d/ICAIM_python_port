#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: icaim-edit-config CASENAME mTIME MTIME NCOMP DATA_INPUT_FILE" >&2
}

if [ "$#" -ne 5 ]; then
  usage
  exit 2
fi

casename="$1"
mtime="$2"
Mtime="$3"
ncomp="$4"
data_input_file="$5"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_PORT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
ICAIM_ROOT="$(cd -- "$PYTHON_PORT_ROOT/.." && pwd)"
#ICAIM_ROOT="$(cd -- "$PYTHON_PORT_ROOT/../.." && pwd)"


config_dir="$ICAIM_ROOT/Scenarios/casestudy/case1/python_port/config"
template_file="$config_dir/config.json.template"
config_file="$config_dir/config.$casename.json"

if [ ! -f "$template_file" ]; then
  echo "template not found: $template_file" >&2
  exit 1
fi

mkdir -p "$config_dir"

sed \
  -e "s#DATA_INPUT_FILE#$data_input_file#g" \
  -e "s#mTIME#$mtime#g" \
  -e "s#MTIME#$Mtime#g" \
  -e "s#NCOMP#$ncomp#g" \
  "$template_file" > "$config_file"

echo "config_file=$config_file"

${EDITOR:-nano} "$config_file"
